{% trans_default_domain 'UmanitTiptapBundle' %}

{% set controller_values = {translations: {placeholder: 'wysiwyg.placeholder'|trans}} %}
{% if this.migrationDiff %}
  {% set controller_values = controller_values|merge({
    migrationDiff: true,
    translations: controller_values.translations|merge({
      diffLost: 'wysiwyg.diff.banner_lost'|trans,
      diffRewritten: 'wysiwyg.diff.banner_rewritten'|trans,
    }),
  }) %}
{% endif %}
{% if this.hasFileManager %}
  {% set controller_values = controller_values|merge({fileManagerUrl: this.fileManagerUrl}) %}
{% endif %}
{% if this.fileManagerAdapter %}
  {% set controller_values = controller_values|merge({fileManagerAdapter: this.fileManagerAdapter}) %}
{% endif %}

<div class="umanit-tiptap" {{ stimulus_controller('umanit/tiptap/editor', controller_values) }} {{ attributes }}>
  {# The modals contain forms, which must not be parsed inside a host form (nested forms are dropped by the HTML
     parser and truncate the host form). The controller inserts them once connected, through the DOM API. #}
  <template {{ stimulus_target('umanit/tiptap/editor', 'modals') }}>
    {% if computed.hasTableTool %}
      <twig:Umanit:Tiptap:ContextMenu:Table />
      <twig:Umanit:Tiptap:Modal:Table id="{{ this.id }}" cellBackgroundColorsSet="{{ this.cellBackgroundColorsSet }}" />
    {% endif %}

    {% if computed.hasImageTool %}
      <twig:Umanit:Tiptap:Modal:Image id="{{ this.id }}" :fileManagerEnabled="this.hasFileManager" />
    {% endif %}

    {% if computed.hasLinkTool %}
      <twig:Umanit:Tiptap:Modal:Link id="{{ this.id }}" />
    {% endif %}

    {% if computed.hasTemplateTool %}
      <twig:Umanit:Tiptap:Modal:Template id="{{ this.id }}" name="{{ this.templatesSet }}" />
    {% endif %}

    {% if computed.hasAnchorTool %}
      <twig:Umanit:Tiptap:Modal:Anchor id="{{ this.id }}" />
    {% endif %}

    {% if this.migrationDiff %}
      <twig:Umanit:Tiptap:Modal:Diff id="{{ this.id }}" />
    {% endif %}
  </template>

  {% if this.migrationDiff %}
    <div class="umanit-tiptap__diff-banner ut-hidden" role="status"
        {{ stimulus_target('umanit/tiptap/editor', 'diffBanner') }}>
      <span {{ stimulus_target('umanit/tiptap/editor', 'diffMessage') }}></span>
      <button type="button" class="umanit-tiptap__modal-btn umanit-tiptap__modal-btn--secondary"
          {{ stimulus_action('umanit/tiptap/editor', 'openDiff') }}>
        {{ 'wysiwyg.diff.show'|trans }}
      </button>
    </div>
  {% endif %}

  <twig:Umanit:Tiptap:Toolbar
      name="{{ this.toolbar }}" stylesSet="{{ this.stylesSet }}" colorsSet="{{ this.colorsSet }}"
      backgroundColorsSet="{{ this.backgroundColorsSet }}" />

  <div class="umanit-tiptap__surface">
    <div {{ stimulus_target('umanit/tiptap/editor', 'editor') }}></div>
  </div>

  <textarea id="{{ this.id }}"{% if this.name %} name="{{ this.name }}"{% endif %}
            class="umanit-tiptap__source ut-hidden" rows="15"
      {{ stimulus_target('umanit/tiptap/editor', 'input') }}>{{ this.content }}</textarea>

  <div class="umanit-tiptap__statusbar">
    <ol class="umanit-tiptap__path" aria-label="{{ 'wysiwyg.path.label'|trans }}"
        {{ stimulus_target('umanit/tiptap/editor', 'path') }}></ol>
    <button type="button" class="umanit-tiptap__resize" title="{{ 'wysiwyg.resize.label'|trans }}"
            aria-label="{{ 'wysiwyg.resize.label'|trans }}"
        {{ stimulus_target('umanit/tiptap/editor', 'resizeHandle')
        |stimulus_action('umanit/tiptap/editor', 'startResize', 'pointerdown')
        |stimulus_action('umanit/tiptap/editor', 'resizeWithKeyboard', 'keydown') }}></button>
  </div>
</div>
