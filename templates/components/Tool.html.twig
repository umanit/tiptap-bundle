{% set tool_configuration = tools[tool]|default(null) %}

{% if not tool_configuration %}
  {% if app.environment == 'dev' %}
    <p class="umanit-tiptap__alert">{{ 'wysiwyg.error.unknown_tool'|trans({'{tool}': tool}) }}</p>
  {% endif %}
{% elseif tool_configuration.command is defined %}
  <twig:Umanit:Tiptap:CommandTool
      class="umanit-tiptap__btn" {{ ...tool_configuration }} data-wysiwyg-tool="{{ tool }}" {{ ...attributes }} />
{% elseif tool == 'styles' %}
  <twig:Umanit:Tiptap:Styles name="{{ stylesSet }}" {{ ...tool_configuration }} {{ ...attributes }} />
{% elseif tool == 'color' %}
  <twig:Umanit:Tiptap:Color
      name="{{ colorsSet }}" type="{{ enum('Umanit\\TiptapBundle\\Twig\\Components\\ColorType').Text }}"
      {{ ...tool_configuration }} {{ ...attributes }} />
{% elseif tool == 'bgColor' %}
  <twig:Umanit:Tiptap:Color
      name="{{ backgroundColorsSet }}"
      type="{{ enum('Umanit\\TiptapBundle\\Twig\\Components\\ColorType').Background }}"
      {{ ...tool_configuration }} {{ ...attributes }} />
{% elseif tool == 'fontSize' %}
  <twig:Umanit:Tiptap:FontSize {{ ...tool_configuration }} {{ ...attributes }} />
{% elseif tool == 'source' %}
  <twig:Umanit:Tiptap:Source {{ ...tool_configuration }} {{ ...attributes }} />
{% endif %}
