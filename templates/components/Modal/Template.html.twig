{% embed '@UmanitTiptap/components/Modal/base.html.twig' with {id: 'templateModal-' ~ id} %}
  {% trans_default_domain 'UmanitTiptapBundle' %}

  {% block title %}{{ 'wysiwyg.modal.template.title'|trans }}{% endblock %}

  {% block content %}
    <form {{ stimulus_target('umanit/tiptap/editor', 'templateForm') }}>
      <div class="umanit-tiptap__field umanit-tiptap__check">
        <input type="checkbox" class="umanit-tiptap__check-input" id="replaceContentCheck-{{ id }}" name="replaceContent">
        <label class="umanit-tiptap__check-label" for="replaceContentCheck-{{ id }}">
          {{ 'wysiwyg.modal.template.replace'|trans }}
        </label>
      </div>

      <p class="umanit-tiptap__hint">{{ 'wysiwyg.modal.template.select_helper'|trans }}</p>

      <div class="umanit-tiptap__list">
        {% for template in this.templates %}
          <label class="umanit-tiptap__list-item">
            <input type="radio" class="ut-visually-hidden" name="template" value="{{ template.content }}">
            <span class="ut-flex ut-w-full ut-justify-between">
              <span class="umanit-tiptap__list-item-title">{{ template.name|trans }}</span>
            </span>
            {% if template.description is not null %}
              <small class="umanit-tiptap__muted">{{ template.description|trans }}</small>
            {% endif %}
          </label>
        {% endfor %}
      </div>
    </form>
  {% endblock %}

  {% block footer %}
    <div class="umanit-tiptap__modal-footer">
      <button type="button" class="umanit-tiptap__modal-btn umanit-tiptap__modal-btn--secondary"
          {{ stimulus_action('umanit/tiptap/modal', 'close') }}>
        {{ 'modal.cancel'|trans }}
      </button>
      <button type="button" class="umanit-tiptap__modal-btn umanit-tiptap__modal-btn--primary"
          {{ stimulus_action('umanit/tiptap/editor', 'run', 'click', {command: 'template.confirm'}) }}>
        {{ 'modal.validate'|trans }}
      </button>
    </div>
  {% endblock %}
{% endembed %}
