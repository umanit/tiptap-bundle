includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon

rules:
    - Umanit\DevBundle\PHPStan\Rules\EnsureFunctionBackslashRule

parameters:
    level: 9
    paths:
        - src/
        - tests/
    ignoreErrors:
        # Supports DBAL 3.8 to 4.x: the editors replacing these methods only exist since DBAL 4.5
        -
            identifier: method.deprecated
            path: src/Doctrine/Migrations/Version20261029000000.php
        # Supports both Symfony 7.4 (HttpKernel BundleInterface) and 8.x (where it is deprecated)
        -
            identifier: return.deprecatedInterface
            path: tests/Fixtures/TestKernel.php
        # Supports both ORM 2.20 and ORM 3, which differ on the setup and on native lazy objects
        -
            identifier: function.alreadyNarrowedType
            paths:
                - tests/Fixtures/Doctrine/SqliteDatabase.php
                - tests/Fixtures/DoctrineTestKernel.php
