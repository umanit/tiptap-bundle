{
  "name": "umanit/tiptap-bundle-playground",
  "description": "Plain Symfony application validating the installation of umanit/tiptap-bundle (AssetMapper and Webpack Encore).",
  "type": "project",
  "license": "MIT",
  "repositories": [
    {
      "type": "path",
      "url": "..",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "symfony/asset-mapper": "^7.4 || ^8.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/dotenv": "^7.4 || ^8.0",
    "symfony/form": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/runtime": "^7.4 || ^8.0",
    "symfony/stimulus-bundle": "^2.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "symfony/ux-icons": "^2.0",
    "symfony/ux-twig-component": "^2.0",
    "symfony/webpack-encore-bundle": "^2.0",
    "symfony/yaml": "^7.4 || ^8.0",
    "umanit/tiptap-bundle": "@dev"
  },
  "autoload": {
    "psr-4": {
      "Playground\\": "src/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "minimum-stability": "stable"
}
